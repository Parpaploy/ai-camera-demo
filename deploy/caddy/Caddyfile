# Public HTTPS front door for the dashboard only. Caddy gets a Let's Encrypt
# cert for this domain automatically and reverse-proxies to the bridge
# (scripts/rdk_mipi_bridge.py), which serves the built web app + /api/data on
# port 8765.
#
# Camera control/stream and the live-detection page stay LAN/Tailscale-only —
# /api/mipi (open/close/view the camera) has no auth of its own, so it must
# never be reachable from the public internet. /dashboard's data IS protected
# (admin login + DATA_API_KEY), which is why only that side is exposed here.
#
# Replace the domain below with your own, then:
#   sudo cp deploy/caddy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
llmdetect.icat-development.duckdns.org {
	@blocked path /detector* /api/mipi/* /api/detect/* /api/ai/*
	respond @blocked 403

	reverse_proxy 127.0.0.1:8765
}
