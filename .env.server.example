# Copy to .env.server. Never use VITE_ for secrets.
DB_HOST=YOUR_CLUSTER_HOST
DB_PORT=4000
DB_USER=YOUR_TIDB_USER
DB_PASSWORD=YOUR_TIDB_PASSWORD
DB_NAME=ai_camera
DB_SSL=true
DATA_API_HOST=127.0.0.1
DATA_API_PORT=8787
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_API_KEY=REPLACE_WITH_A_RANDOM_KEY_AT_LEAST_24_CHARACTERS
# Admin sign-in password. Generate a private value of 16+ characters.
DASHBOARD_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_ADMIN_PASSWORD
